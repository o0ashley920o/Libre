{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "sanity:typegen": {
      "cache": false
    },
    "studio#sanity:typegen": {
      "outputs": ["../sanity.schema.json"],
      "cache": false
    },
    "frontend#sanity:typegen": {
      "dependsOn": ["studio#sanity:typegen"],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "dependsOn": ["sanity:typegen"],
      "cache": false,
      "persistent": true,
      "interactive": true
    }
  }
}
